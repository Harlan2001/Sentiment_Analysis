LEGACY_API_BASE_URL=http://127.0.0.1:8000
WORKBENCH_API_PREFIX=/api/workbench
WORKBENCH_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
WORKBENCH_LEGACY_TIMEOUT_SECONDS=180
WORKBENCH_CONVERSATION_HISTORY_LIMIT=50

# 主机、端口、账号、密码和字符集默认复用根目录 .env 的 MYSQL_*。
# 唯一必须覆盖的是数据库名；工作台拒绝连接任何其他库。
WORKBENCH_MYSQL_DATABASE=Sentiment_analysis_test
