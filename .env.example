# =============================================================================
# API 路由前缀（默认 /sapi，用于与云上其他服务区分）
API_PREFIX=/sapi

LLM_API_KEY=your_llm_api_key_here
# kingstar API Base URL
LLM_BASE_URL=your_llm_api_base_url_here

# =============================================================================
# 模型选择（短名 + 注册表解析，注册表见 backend/config/config.py）
# =============================================================================
# 新闻分析默认模型短名（glm = glm-5.2）
ANALYSIS_MODEL_NAME=glm
# Agent 聊天默认模型短名（同为注册表短名，缺省跟随 ANALYSIS_MODEL_NAME）
CHAT_MODEL_NAME=glm

# MySQL
MYSQL_HOST=your_mysql_host
MYSQL_PORT=your_mysql_port
MYSQL_USER=user
MYSQL_PASSWORD=your_mysql_password_here
# 生产/主数据库（测试一律不得指向此库）
MYSQL_DATABASE=Sentiment_analysis
# 集成测试专用库，库名必须 *_test 结尾；未设置时集成测试自动跳过，防止误连生产库
MYSQL_TEST_DATABASE=Sentiment_analysis_test
MYSQL_CHARSET=utf8mb4
MYSQL_AUTOCOMMIT=true

# Python 输出缓冲设置（推荐保持为 1）
PYTHONUNBUFFERED=1

# =============================================================================
# 代理配置（可选）
# =============================================================================
# 外发请求代理开关：true 且填好 HTTP_PROXY/HTTPS_PROXY 时走代理；置空（默认）则直连
OUTBOUND_PROXY_ENABLED=false
HTTP_PROXY=
HTTPS_PROXY=

# =============================================================================
# 策略以及标的选择建议生成的相关配置
# =============================================================================

# 工号信息（你截图里的 admin 工号）
KINGSTAR_EMPLOYEE_NO=your_employee_no_here

# 接口地址（你抓到的真实可用地址）
STRATEGY_API_BASE_URL=http://your_strategy_api_base_url_here
BOND_API_BASE_URL=http://your_bond_api_base_url_here

QUANT_STRATEGY_BASE_URL=http://your_quant_strategy_base_url_here
QUANT_STRATEGY_TOKEN=Bearer your_quant_strategy_token_here

# 【临时兼容】本地快照模式（SaaS 无法访问内网 API 时的替代方案）
# 使用前需在内网环境运行: python scripts/generate_snapshot.py
USE_LOCAL_SNAPSHOT=false
SNAPSHOT_DIR=data/snapshots

# =============================================================================
# 登录认证配置
# =============================================================================
# 是否启用登录认证（true=需要登录，false=免登录，默认false）
AUTH_ENABLED=false

# JWT 密钥（启用认证时必须设置，建议 32 位以上随机字符串）
JWT_SECRET_KEY=your_random_secret_key_here

# JWT 过期时间（小时），默认 24 小时
JWT_EXPIRY_HOURS=24

# 是否启用手机号登录（true=启用，false=仅账号密码登录，默认true）
AUTH_PHONE_LOGIN=true

# 内部服务调用 token——启用认证后，Agent 内部 HTTP 调用（如触发分析流水线）需携带此值：
# Authorization: Bearer <该值>。未配置时启用认证会导致这些内部接口不可访问。
SENTIMENT_INTERNAL_API_TOKEN=your_internal_token

# =============================================================================
# PDF 推送 & 飞书机器人配置
# =============================================================================
# 飞书自建应用配置
FEISHU_APP_ID=app_id_here
FEISHU_APP_SECRET=app_secret_here
FEISHU_GROUP_ID=group_id_here
# OAuth callback must exactly match the redirect URL configured in the Feishu app.
FEISHU_OAUTH_REDIRECT_URI=http://localhost:8001/sapi/mcp/feishu/callback
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FEISHU_TOKEN_ENCRYPTION_KEY=your_fernet_key_here

# =============================================================================
# AI策略生成
# =============================================================================
# Required only after the user confirms a prompt draft for DreamStrategy generation.
DREAM_PORTAL_CONFIG_URL=https://your-dream-portal/config.json
DREAM_TEMPLATE_ID=your_dream_template_id
DREAM_AGENT=deepseek-chat
DREAM_TIMEOUT_SECONDS=900
# Maximum time to wait for Dream's asynchronous per-version backtest result.
DREAM_BACKTEST_WAIT_SECONDS=180
